# Public values used by the Next.js frontend. `npx convex dev` writes the
# development URL to .env.local.
NEXT_PUBLIC_CONVEX_URL=https://your-development-deployment.convex.cloud
NEXT_PUBLIC_PUBLIC_URL=http://localhost:3000

# Configure these on Convex with `npx convex env set`. They are listed only as
# documentation; never place real values in this tracked example.
# ADMIN_PASSWORD=
# GEMINI_API_KEY=
# DEMO_MODE=false
# GEMINI_LIVE_MODEL=gemini-3.5-live-translate-preview
# GEMINI_TEXT_MODEL=gemini-flash-lite-latest
# GEMINI_EXTRACT_MODEL=
